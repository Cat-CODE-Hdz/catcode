# Número de WhatsApp de CAT CODE en formato internacional, sin + ni espacios.
# Ejemplo España: 34600000000
# PENDIENTE: sin número configurado, los botones de WhatsApp abren wa.me sin destino.
VITE_WHATSAPP_NUMBER=

# Google Analytics 4 (medición sin cookies + Consent Mode denegado por defecto).
# Formato: G-XXXXXXXXXX. Si está vacío, no se carga ningún script de medición.
VITE_GA_MEASUREMENT_ID=

# PageSpeed Insights API (solo para el script de build, nunca en el cliente)
# Obtener en: https://console.cloud.google.com/apis/credentials
# Sin API key limita a ~400 requests/día
PAGESPEED_API_KEY=

# URL del sitio a medir (para pre-build script)
SITE_URL=https://catcode.es/
